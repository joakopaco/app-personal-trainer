VITE_SUPABASE_URL=http://127.0.0.1:54341
VITE_SUPABASE_ANON_KEY=
# Public Turnstile site key; mandatory outside the isolated local backend.
# Configure its SECRET only in Supabase Auth, never in VITE_*.
VITE_TURNSTILE_SITE_KEY=
# Pilot without email delivery: false. Match Supabase Confirm email setting.
# Omitted/true preserves verified-email signup and email recovery.
VITE_AUTH_EMAIL_ENABLED=true
